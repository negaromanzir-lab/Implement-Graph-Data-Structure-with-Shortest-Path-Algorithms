
#include <iostream>
#include <vector>
#include <queue>
#include <climits>
#include <algorithm>
#include <limits>
using namespace std;

class Graph {
private:
    int vertices;
    vector<vector<pair<int, int>>> adj;

public:
    Graph(int v) {
        vertices = v;
        adj.resize(v);
    }

    void addEdge(int u, int v, int weight) {
        adj[u].push_back({v, weight});
        adj[v].push_back({u, weight});
    }

    void shortestRoute(int source, int destination) {
        vector<int> dist(vertices, INT_MAX);
        vector<int> parent(vertices, -1);

        priority_queue<
            pair<int, int>,
            vector<pair<int, int>>,
            greater<pair<int, int>>
        > pq;

        dist[source] = 0;
        pq.push({0, source});

        while (!pq.empty()) {
            int currentDist = pq.top().first;
            int u = pq.top().second;
            pq.pop();

            if (currentDist > dist[u])
                continue;

            for (auto edge : adj[u]) {
                int v = edge.first;
                int weight = edge.second;

                if (dist[u] <= INT_MAX - weight &&
                    dist[u] + weight < dist[v]) {

                    dist[v] = dist[u] + weight;
                    parent[v] = u;

                    pq.push({dist[v], v});
                }
            }
        }

        if (dist[destination] == INT_MAX) {
            cout << "\nNo route exists between "
                 << source << " and " << destination << ".\n";
            return;
        }

        vector<int> path;

        for (int v = destination; v != -1; v = parent[v])
            path.push_back(v);

        reverse(path.begin(), path.end());

        cout << "\n========== SHORTEST ROUTE ==========\n";
        cout << "Shortest Distance: " << dist[destination] << endl;

        cout << "Route: ";

        for (int i = 0; i < path.size(); i++) {
            cout << path[i];

            if (i != path.size() - 1)
                cout << " -> ";
        }

        cout << "\n====================================\n";
    }

    int getVertices() {
        return vertices;
    }
};

int main() {
    int V, E;

    cout << "====================================\n";
    cout << "      GRAPH SHORTEST ROUTE SYSTEM\n";
    cout << "====================================\n";

    cout << "Enter number of vertices: ";

    if (!(cin >> V) || V <= 0) {
        cout << "Invalid number of vertices!\n";
        return 1;
    }

    cout << "Enter number of edges: ";

    if (!(cin >> E) || E < 0) {
        cout << "Invalid number of edges!\n";
        return 1;
    }

    Graph graph(V);

    cout << "\nEnter edges (source destination weight)\n";
    cout << "Vertices must be between 0 and " << V - 1 << ".\n";

    for (int i = 0; i < E; i++) {
        int u, v, w;

        cout << "Edge " << i + 1 << ": ";

        if (!(cin >> u >> v >> w)) {
            cout << "Invalid edge input!\n";
            return 1;
        }

        if (u < 0 || u >= V || v < 0 || v >= V || w < 0) {
            cout << "Invalid vertices or negative weight!\n";
            return 1;
        }

        graph.addEdge(u, v, w);
    }

    int source, destination;

    cout << "\nEnter source vertex: ";

    if (!(cin >> source) || source < 0 || source >= V) {
        cout << "Invalid source vertex!\n";
        return 1;
    }

    cout << "Enter destination vertex: ";

    if (!(cin >> destination) ||
        destination < 0 || destination >= V) {
        cout << "Invalid destination vertex!\n";
        return 1;
    }

    graph.shortestRoute(source, destination);

    return 0;
}
